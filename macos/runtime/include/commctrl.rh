// Wraps Wine's commctrl.rh, the common control styles resource scripts see: adds the SysLink styles,
// which Windows' copy has and resource scripts use.

#pragma once

#include_next <commctrl.rh>

#ifndef LWS_TRANSPARENT
#define LWS_TRANSPARENT 0x0001
#define LWS_IGNORERETURN 0x0002
#define LWS_NOPREFIX 0x0004
#define LWS_USEVISUALSTYLE 0x0008
#define LWS_USECUSTOMTEXT 0x0010
#define LWS_RIGHT 0x0020
#endif
