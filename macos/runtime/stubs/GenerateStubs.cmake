# Generates weak stubs for the Win32 functions the program references and the runtime does not
# implement yet, so that the app links while the runtime is being written. A stub reports its
# name the first time it is called and returns 0 (failure for most Win32 functions).
#
# Run by cmake -P with:
#   NM, CC           tools
#   LINK_LIBRARIES   |-separated system libraries and frameworks the app links (e.g. -framework|Cocoa)
#   INPUTS_FILE      file listing (one per line) object files and static libraries whose undefined
#                    symbols need definitions
#   PROVIDERS_FILE   file listing the object files and static libraries that define symbols
#   OUTPUT           the C file to write
#
# Which names the system provides is decided by the linker itself: a probe program referencing every
# candidate is linked against the app's system libraries, and only the names it reports undefined
# are stubbed. (Asking the dynamic loader is not enough: Cocoa loads Carbon, which defines ShowWindow,
# MoveWindow and other Win32 names the app must not bind to.)

file(STRINGS "${INPUTS_FILE}" INPUTS)
file(STRINGS "${PROVIDERS_FILE}" PROVIDERS)
string(REPLACE "|" ";" LINK_LIBRARIES "${LINK_LIBRARIES}")

set(undefined "")
foreach(input IN LISTS INPUTS)
	execute_process(COMMAND "${NM}" -u -j "${input}" OUTPUT_VARIABLE symbols ERROR_QUIET)
	string(REPLACE "\n" ";" symbols "${symbols}")
	list(APPEND undefined ${symbols})
endforeach()

set(defined "")
foreach(provider IN LISTS PROVIDERS)
	execute_process(COMMAND "${NM}" -U -j -g "${provider}" OUTPUT_VARIABLE symbols ERROR_QUIET)
	string(REPLACE "\n" ";" symbols "${symbols}")
	list(APPEND defined ${symbols})
endforeach()

list(REMOVE_DUPLICATES undefined)
list(FILTER undefined INCLUDE REGEX "^__?[A-Za-z]") # C names, including Win32's own _Underscored ones
list(FILTER undefined EXCLUDE REGEX "^__Z") # C++ symbols are implemented by hand, never stubbed
list(FILTER undefined EXCLUDE REGEX "^_OBJC_|^_objc_|^___|^_\\.")
if(defined)
	list(REMOVE_ITEM undefined ${defined})
endif()

# Link a program that references every candidate against the app's system libraries.
set(probeSource "${OUTPUT}.probe.c")
# Each reference gets its own C identifier bound to the symbol with an asm label, so that names
# that are also compiler builtins (strcasecmp, ...) cannot clash.
set(probeContent "")
set(probeReferences "")
set(index 0)
foreach(symbol IN LISTS undefined)
	string(APPEND probeContent "extern char probe${index} __asm__(\"${symbol}\");\n")
	string(APPEND probeReferences "\t&probe${index},\n")
	math(EXPR index "${index} + 1")
endforeach()
file(WRITE "${probeSource}" "${probeContent}\nvoid* const nppmacProbeReferences[] = {\n${probeReferences}};\nint main(void) { return nppmacProbeReferences[0] != 0; }\n")
execute_process(
	COMMAND "${CC}" -w "${probeSource}" -o "${OUTPUT}.probe" ${LINK_LIBRARIES}
	ERROR_VARIABLE linkErrors OUTPUT_QUIET
)

set(missing "")
string(REPLACE "\n" ";" linkErrorLines "${linkErrors}")
foreach(line IN LISTS linkErrorLines)
	if(line MATCHES "^  \"_([A-Za-z0-9_]+)\", referenced from:")
		list(APPEND missing "${CMAKE_MATCH_1}")
	endif()
endforeach()
list(REMOVE_DUPLICATES missing)
list(SORT missing)

set(content "// Generated by macos/runtime/stubs/GenerateStubs.cmake. Do not edit.\n")
string(APPEND content "// Weak stand-ins for Win32 functions the runtime does not implement yet.\n\n")
string(APPEND content "void nppmacReportStub(const char* name, int* reported);\n\n")
foreach(name IN LISTS missing)
	string(APPEND content "__attribute__((weak)) unsigned long ${name}(void)\n{\n\tstatic int reported = 0;\n\tnppmacReportStub(\"${name}\", &reported);\n\treturn 0;\n}\n\n")
endforeach()

list(LENGTH missing count)
string(APPEND content "const int nppmacStubCount = ${count};\n")

# Write only on change, so an unchanged list does not relink.
set(existing "")
if(EXISTS "${OUTPUT}")
	file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
	file(WRITE "${OUTPUT}" "${content}")
endif()
message(STATUS "Win32 functions still stubbed: ${count}")
