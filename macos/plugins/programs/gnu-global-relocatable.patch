 /**
+ * put_program_dir: put the directory of the running program.
+ *
+ *	@param[out]	sb	the directory is appended to it
+ *
+ * The programs are carried in a package (Notepad++'s NppGTags plugin)
+ * rather than installed where they were configured, so 'bindir' and
+ * 'datadir' are taken relative to them, as on Windows.
+ */
+static void
+put_program_dir(STRBUF *sb)
+{
+	char path[PATH_MAX], real[PATH_MAX], *p;
+	uint32_t size = sizeof(path);
+
+	if (_NSGetExecutablePath(path, &size) != 0 || realpath(path, real) == NULL)
+		die("cannot get the path of this program.");
+	p = strrchr(real, '/');
+	if (p != NULL)
+		*p = '\0';
+	strbuf_puts(sb, real);
+}
+#endif
